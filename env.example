# ── Reverse Image & Face Search ──────────────────────────────────────────────
# 1. FaceCheck.ID (RECOMMENDED for Instagram / social media faces)
#    Get an API token from: https://facecheck.id/Face-Search/API
#    Enables biometric face recognition across Instagram, Telegram, Twitter/X, LinkedIn, VK
FACECHECK_API_KEY=your_facecheck_api_token_here

# 2. Bing Visual Search
#    OPTIONAL: FaceTrace automatically uses a built-in free Playwright scraper for Bing!
#    Only add BING_SEARCH_KEY if you have an official Azure Bing Search resource key.
BING_SEARCH_KEY=

# 3. SerpApi (Google Lens fallback — 100 free searches/month)
#    Get key from: https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# 4. Google Custom Search (Optional)
# GOOGLE_CSE_KEY=your_google_cloud_api_key
# GOOGLE_CSE_CX=your_custom_search_engine_id

# ── Blockchain (Sepolia only — not needed for localhost) ──────────────────────
INFURA_SEPOLIA_URL=https://sepolia.infura.io/v3/your_infura_project_id
DEPLOYER_PRIVATE_KEY=your_metamask_private_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=DEBUG
