{
  "name": "face-blockchain-pipeline",
  "version": "1.0.0",
  "description": "Face identification + blockchain verification pipeline",
  "scripts": {
    "compile": "hardhat compile",
    "deploy:local": "hardhat run blockchain/scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run blockchain/scripts/deploy.js --network sepolia",
    "verify:local": "hardhat run blockchain/scripts/verify.js --network localhost",
    "verify:sepolia": "hardhat run blockchain/scripts/verify.js --network sepolia",
    "node": "hardhat node"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ethers": "^6.11.0"
  }
}
