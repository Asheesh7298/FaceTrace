# ── FaceTrace environment ────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values. Never commit `.env`.

# SerpApi — powers Google Lens identity + name-based social search + reference photos.
# Free tier: 100 searches/month. Get a key at https://serpapi.com
# REQUIRED for the identity/search stage.
SERPAPI_KEY=your_serpapi_key_here

# FaceCheck.ID — biometric face search across social media (finds semi-famous
# people Google Lens can't). Paid (small credit pack). https://facecheck.id
# Optional but STRONGLY recommended for best coverage on arbitrary faces.
FACECHECK_API_KEY=
# Set to 1 to validate the FaceCheck wiring for FREE (returns DEMO results only,
# not real matches). Set to 0 (or remove) for real biometric search.
FACECHECK_DEMO=0

# Set to 1 to enable the Yandex reverse-image booster (Playwright browser —
# slower and can hit CAPTCHAs; off by default for reliable live demos).
ENABLE_YANDEX=0

# Sepolia testnet — only needed to anchor on the public chain
# (`--network sepolia`). The default demo runs on a local Hardhat node
# and needs neither of these.
INFURA_SEPOLIA_URL=https://sepolia.infura.io/v3/your_project_id
DEPLOYER_PRIVATE_KEY=0xyour_wallet_private_key

# Google Custom Search — legacy/optional fallback, NOT required.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
